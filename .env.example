# ═══════════════════════════════════════════════════════════════
# DHRITI DENTAL — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file → .env.local and fill in real values.
# NEVER commit .env.local to git (it's in .gitignore).
# On Vercel / Netlify, add these in your hosting dashboard.
# ═══════════════════════════════════════════════════════════════

# ── EmailJS (appointment form emails) ──────────────────────────
# Setup guide: https://www.emailjs.com (free — 200 emails/month)
# Without these, the form falls back to WhatsApp automatically.
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# ── Google Analytics GA4 (optional but recommended) ────────────
# Get from: analytics.google.com → Create Property → Web
# Without this, no analytics are collected.
VITE_GA_ID=G-XXXXXXXXXX

# ── Site URL ────────────────────────────────────────────────────
# Used in sitemap and OG tags. Use the live domain when deploying.
VITE_SITE_URL=https://drbarvind.com
